# ========================================================
# Aashav 2026 Hackathon Timer Configuration
# ========================================================

# Organizer Passcode / PIN for /control and privileged operations
# Default is 'aashav2026' if left unset
TIMER_CONTROL_SECRET=aashav2026

# Optional: MongoDB Database URI
# e.g., mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# If omitted, timer state automatically persists to local file storage (data/timer-state.json)
MONGODB_URI=
MONGODB_DB=aashav2026
